# ─── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# ─── Virtual environments ─────────────────────────────────────
venv/
.venv/
env/
.env

# ─── Runtime data (auto-generated, not for version control) ──
data/*.json
data/*.pid
data/*.log

# ─── Export output ────────────────────────────────────────────
exports/

# ─── macOS system files ───────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ─── Editor / IDE ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Keep the data directory itself ──────────────────────────
!data/.gitkeep
!data/
